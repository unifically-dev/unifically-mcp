{
  "name": "@unifically/mcp-server",
  "version": "1.1.0",
  "description": "UnificAlly MCP server: AI video, image generation, music, speech, transcription and upscaling from 100+ models (Veo, Kling, Seedance, Nano Banana, Flux, GPT Image, Suno, ElevenLabs, Topaz) with one API key.",
  "mcpName": "com.unifically/mcp",
  "type": "module",
  "bin": {
    "unifically-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node tests/smoke.mjs",
    "test:vitest": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mcp",
