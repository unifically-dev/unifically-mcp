    "kling",
    "seedance",
    "nano banana",
    "flux",
    "gpt-image",
    "suno",
    "elevenlabs",
    "topaz",
    "claude",
    "cursor",
    "generative-ai"
  ],
  "author": "UnificAlly <contact@unifically.com> (https://unifically.com)",
