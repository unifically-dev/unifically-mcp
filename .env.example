# Required - get yours at https://unifically.com/api-keys
UNIFICALLY_API_KEY=sk-...

# Optional - override the API base URL (staging, proxy, etc.)
UNIFICALLY_BASE_URL=https://api.unifically.com

# Optional - override the file storage base URL (used by upload_file / auto-upload)
UNIFICALLY_FILES_BASE_URL=https://files.unifically.com

# Optional - polling tunables (milliseconds)
UNIFICALLY_POLL_TIMEOUT_MS=600000
UNIFICALLY_POLL_START_MS=2000
UNIFICALLY_POLL_MAX_MS=10000

# Optional - per-request HTTP timeout and retry count for transient errors
UNIFICALLY_REQUEST_TIMEOUT_MS=60000
UNIFICALLY_MAX_RETRIES=3

# --- Operator guardrails (all OFF by default) ---
# Soft spend gate: a call costing more than this returns a confirmation prompt;
# the agent proceeds by retrying with confirm_cost:true. e.g. 0.50
# UNIFICALLY_CONFIRM_COST_ABOVE=0.50
#
# Hard spend cap: a call costing more than this is REJECTED and cannot be
# bypassed (confirm_cost does not override it). e.g. 2.00
# UNIFICALLY_MAX_COST_PER_TASK=2.00
#
# Model gating (comma-separated aliases or full ids). Use ONE of these:
#   blocklist - everything allowed except these
# UNIFICALLY_BLOCKED_MODELS=veo-quality,suno
#   allowlist - ONLY these models may run
# UNIFICALLY_ALLOWED_MODELS=nano-banana,flux,tts
#
# Read-only mode: disables all paid generation; browsing/pricing/balance still work.
# UNIFICALLY_DISABLE_GENERATION=true

# Optional - transport: "stdio" (default) or "http" (remote/hosted server)
MCP_TRANSPORT=stdio

# Optional - internal HTTP transport port (normally set by the deployment platform)
# PORT=<internal-port>

# HTTP transport only ---------------------------------------------------------
# Every hosted HTTP request must send the caller's own API key. The environment
# key above is used only by the local stdio transport.

# Optional - restrict browser CORS origin (default "*")
# UNIFICALLY_CORS_ORIGIN=https://app.example.com

# Optional - reverse proxies allowed to supply X-Forwarded-For. Default is
# loopback only. Accepts: loopback, private, exact IPs, or CIDRs (comma-separated).
# Use `private` only on an isolated container network where untrusted workloads
# cannot connect to this service directly.
# UNIFICALLY_TRUSTED_PROXIES=loopback

# Optional - also honor CF-Connecting-IP from an already-trusted proxy. Leave
# false unless the proxy overwrites this header with Cloudflare's authenticated
# value. X-Forwarded-For remains supported without this.
# UNIFICALLY_TRUST_CF_CONNECTING_IP=false
